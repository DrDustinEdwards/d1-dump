{
  "name": "@dustinedwards/d1-dump",
  "version": "0.13.1",
  "private": true,
  "description": "A per-table D1 dump into the site's own R2 bucket, which works where wrangler d1 export fails on FTS5, with a restore and a backup-age reading for health.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.14.1"
  },
  "bin": {
    "d1-dump": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "bloat": "devkit-no-bloat",
    "lint": "oxlint --type-aware --deny-warnings --report-unused-disable-directives-severity=error"
  },
  "devDependencies": {
    "@dustinedwards/devkit": "github:DrDustinEdwards/devkit#v0.23.0",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "miniflare": "4.20260730.0",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "workerd": false
  }
}
